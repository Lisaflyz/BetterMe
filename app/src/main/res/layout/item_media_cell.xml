<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cellRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/album_surface">

    <ImageView
        android:id="@+id/ivThumb"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no" />

    <!-- 视频：时长 + 播放角标 -->
    <LinearLayout
        android:id="@+id/videoTag"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="4dp"
        android:background="@drawable/bg_video_time"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingTop="2dp"
        android:paddingEnd="6dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="12dp"
            android:layout_height="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_play_small" />

        <TextView
            android:id="@+id/tvDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="3dp"
            android:textColor="@color/white"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView android:id="@+id/liveTag" android:layout_width="22dp" android:layout_height="22dp"
        android:layout_gravity="top|start" android:layout_margin="6dp"
        android:src="@drawable/ic_album_live_photo" android:contentDescription="@string/album_live_photo"
        android:visibility="gone"/>

    <!-- 选择序号角标 -->
    <TextView
        android:id="@+id/tvBadge"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/bg_badge"
        android:gravity="center"
        android:textColor="@color/album_background"
        android:textSize="11sp"
        android:textStyle="bold"
        android:visibility="gone" />
</FrameLayout>
