<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:focusable="true" android:contentDescription="@string/daily_view_photo">
    <ImageView android:id="@+id/image" android:layout_width="match_parent" android:layout_height="match_parent"
        android:scaleType="centerCrop" android:importantForAccessibility="no" />
    <TextView android:id="@+id/missing" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:text="@string/daily_media_unavailable" android:visibility="gone"
        android:textColor="@color/text_secondary" />
</FrameLayout>
