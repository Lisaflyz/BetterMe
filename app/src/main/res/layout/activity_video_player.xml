<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:use_controller="false"
        app:resize_mode="fit"
        app:shutter_background_color="@android:color/black" />

    <View
        android:id="@+id/videoTapArea"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="true"
        android:focusable="true"
        android:contentDescription="@string/player_pause" />

    <ImageButton
        android:id="@+id/btnPaused"
        android:layout_width="76dp"
        android:layout_height="76dp"
        android:layout_gravity="center"
        android:padding="12dp"
        android:src="@drawable/ic_player_play"
        android:background="@android:color/transparent"
        android:contentDescription="@string/player_resume"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/loading"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_gravity="center"
        android:indeterminateTint="@android:color/white"
        android:visibility="gone" />

    <!-- Only controls are inset; the video continues to fill the window. -->
    <FrameLayout
        android:id="@+id/safeControls"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/errorPanel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:visibility="gone">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/player_error"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                android:shadowColor="#FF000000"
                android:shadowRadius="3" />
            <Button
                android:id="@+id/btnRetry"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/preview_retry" />
            <Button
                android:id="@+id/btnReturn"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/player_return_diary" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="top|start"
            android:layout_marginTop="8dp"
            android:padding="12dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@android:color/white"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/back" />

        <LinearLayout
            android:id="@+id/videoControls"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="bottom"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:clickable="true">
            <TextView
                android:id="@+id/currentTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:shadowColor="#FF000000"
                android:shadowRadius="3" />
            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:max="1000"
                android:thumbTint="@android:color/white"
                android:progressTint="@android:color/white"
                android:progressBackgroundTint="#66FFFFFF"
                android:contentDescription="@string/preview_progress" />
            <TextView
                android:id="@+id/totalTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:00"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:shadowColor="#FF000000"
                android:shadowRadius="3" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
