<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="DailyDeleteDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="materialAlertDialogTitleTextStyle">@style/DailyDeleteDialogTitle</item>
        <item name="buttonBarNegativeButtonStyle">@style/DailyDeleteDialogCancel</item>
        <item name="buttonBarPositiveButtonStyle">@style/DailyDeleteDialogConfirm</item>
    </style>

    <style name="DailyDeleteDialogTitle" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/text_primary</item>
    </style>

    <style name="DailyDeleteDialogCancel" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="rippleColor">@color/ripple_dark</item>
    </style>

    <style name="DailyDeleteDialogConfirm" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/error</item>
        <item name="rippleColor">@color/ripple_dark</item>
    </style>
</resources>
